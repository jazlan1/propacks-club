# PRO PACKS Environment Configuration (Placeholder Values Only)
PORT=3001
NODE_ENV=production

# Generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-64-char-random-secret

# Comma-separated allowed CORS origins in production
ALLOWED_ORIGINS=https://propacks.club,https://www.propacks.club

